                              "day":   { "color": "#FFFFFF", "alpha": 0.12 } },
    "focus.outer":          { "use": "2 px focus ring", "night": "#F1F0F4", "day": "#17151C" },
    "focus.inner":          { "use": "1 px inner ring",
                              "night": { "color": "#000000", "alpha": 0.70 },
                              "day":   { "color": "#FFFFFF", "alpha": 0.70 } },

    "status.critical":      { "use": "errors, battery critical", "night": "#FF6B85", "day": "#C4264B" },
    "status.caution":       { "use": "warnings; day a shade deeper than the first draft so it still holds 4.5:1 on bg.secondary, the darkest day surface", "night": "#FFC857", "day": "#945E00" },
    "status.success":       { "night": "#5FE0A1", "day": "#0E7A47" },
    "status.info":          { "night": "#8FB8FF", "day": "#2F5FC9" },

    "caption.close":        { "use": "close button hover, white glyph", "night": "#E5334F", "day": "#E5334F" },
    "caption.close.pressed":{ "night": "#C22A44", "day": "#C22A44" },

    "acrylic.tint":         { "use": "menus, popups, Start, tray, OSD",
                              "night": { "color": "#1B1A20", "alpha": 0.8 },
                              "day": { "color": "#FAFAFB", "alpha": 0.82 } },
    "acrylic.taskbar":      { "use": "taskbar; its SVG is painted with the Window background of the scheme, so it is light in Day and the shell's taskbar text follows",
                              "night": { "color": "#131217", "alpha": 0.86 },
                              "day": { "color": "#F5F4F7", "alpha": 0.86 } },
    "shadow":               { "use": "colour of shadows", "night": "#000000", "day": "#17151C" },

    "selection.inactive":   { "use": "secondary text on the accent; white on the violet is 5.34:1, so every tint on it sits close to white to keep 4.5:1 - the hue is a hint, not a colour", "night": "#F0EAFF", "day": "#F0EAFF" },
    "selection.visited":    { "use": "a visited link on a selected row", "night": "#F2EAFF", "day": "#F2EAFF" },
    "selection.negative":   { "night": "#FFE8EC", "day": "#FFE8EC" },
    "selection.neutral":    { "night": "#FFEBC0", "day": "#FFEBC0" },
    "selection.positive":   { "night": "#CFF6E0", "day": "#CFF6E0" }
  },

  "brand": {
    "about": "Mode-independent Raye colours for full-screen pictures (installer, boot, login backdrops).",
    "violet": "#7B3CFF",
    "magenta": "#C040FF",
    "night.from": "#0E0A17",
    "night.to": "#1A1028",
    "crash": "#2A1052"
  },

  "accent_rule": {
    "about": "How a user-picked accent gives its other shades, at run time (the Qt style, Tokens.qml). The default accent keeps the hand-tuned values of the colour table.",
    "default": "#7B3CFF",
    "unthemed": { "about": "Qt's own palette and Plasma's built-in one: what a program sees with no colour scheme written out. Raye never ships them, so Tokens.qml paints Raye Night with the default accent instead.",
                  "window": ["#EFEFEF", "#EFF0F1"], "highlight": ["#308CC6", "#3DAEE9"] },
    "hover":   { "night": { "toward": "#FFFFFF", "amount": 0.12 }, "day": { "toward": "#000000", "amount": 0.12 } },
    "pressed": { "night": { "toward": "#000000", "amount": 0.12 }, "day": { "toward": "#000000", "amount": 0.24 } },
    "text":    { "about": "Accent text and links are lifted past AA: on violet-tinted surfaces the colour itself eats legibility, so the floor is 7:1 on night and 6:1 on day, which is where the table's own shades sit.",
                 "on": "bg.base", "step": 0.02,
                 "night": { "toward": "#FFFFFF", "min_contrast": 7.0 },
                 "day":   { "toward": "#000000", "min_contrast": 6.0 } },
    "disabled": { "about": "The accent at alpha over the surface, then moved toward its own grey: a disabled fill reads as greyed out, not as a darker accent.",
                  "over": "bg.base", "alpha": 0.35, "desaturate": 0.30 },
    "on_accent": { "about": "White or dark text, whichever keeps the ratio on the accent, its hover and its pressed shade together. When neither does, hover and pressed are moved back toward the accent until the text holds (or as far as the accent itself allows); a pressed shade left with less than half its change goes the other way (white for black), and a hover left with less than half its change goes the pressed way at half the pressed change, so every state still shows.",
                   "light": "#FFFFFF", "dark": "#17151C", "min_contrast": 4.5, "back_off_step": 0.005 },
    "selection": { "about": "The five tinted foregrounds of a selected row, on the selection itself. A fraction toward a target guarantees NO ratio -- it only happened to land well on the violet it was tuned for -- so the tint's LIGHTNESS is walked until the WCAG minimum holds on BOTH selection backgrounds at once, hue and saturation untouched. It stops at white or at the dark text when the ratio cannot be reached, which is only on an accent no text colour holds 4.5:1 on; there the floor is what the best of the two text colours gets, so a tint is never worse than the readable ceiling of its own background. Tints go the way text.onAccent went, so every foreground of a selected row sits on the same side.",
                   "on": ["accent", "accent.pressed"], "min_contrast": 4.5, "step": 0.005,
                   "hue": { "about": "\"accent\": the tint is a hint of the accent, so it starts where the table puts it between the text on the accent and the accent itself, and carries the accent's hue. \"own\": the token keeps its own hue, because red, amber and green are SIGNALS -- a negative that reads as the accent says nothing.",
                            "selection.inactive": "accent", "selection.visited": "accent",
                            "selection.negative": "own", "selection.neutral": "own",
                            "selection.positive": "own" } }
  },

  "contrast": {
    "about": "WCAG 2 pairs the tests hold every mode to: [foreground, background, minimum ratio].",
    "pairs": [
      ["text.primary",   "bg.base", 4.5], ["text.primary",   "bg.secondary", 4.5], ["text.primary",   "bg.tertiary", 4.5],
      ["text.primary",   "bg.quarternary", 4.5], ["text.primary", "bg.layer", 4.5], ["text.primary", "bg.card", 4.5],
      ["text.primary",   "bg.card.hover", 4.5], ["text.primary", "bg.tooltip", 4.5], ["text.primary", "fill.control", 4.5],
      ["text.primary",   "fill.control.hover", 4.5], ["text.primary", "fill.input.active", 4.5],
      ["text.secondary", "bg.base", 4.5], ["text.secondary", "bg.secondary", 4.5], ["text.secondary", "bg.tertiary", 4.5],
      ["text.secondary", "bg.quarternary", 4.5], ["text.secondary", "bg.layer", 4.5], ["text.secondary", "bg.card", 4.5],
      ["text.secondary", "bg.tooltip", 4.5], ["text.secondary", "fill.control", 4.5],
      ["text.secondary", "bg.card.hover", 4.5], ["text.secondary", "fill.control.hover", 4.5],
      ["text.tertiary",  "bg.base", 4.5], ["text.tertiary", "bg.secondary", 4.5], ["text.tertiary", "bg.tertiary", 4.5],
      ["text.tertiary",  "bg.quarternary", 4.5], ["text.tertiary", "bg.layer", 4.5], ["text.tertiary", "bg.card", 4.5],
      ["text.tertiary",  "fill.control", 4.5], ["text.tertiary", "fill.input.active", 4.5],
      ["text.tertiary",  "bg.card.hover", 4.5], ["text.tertiary", "fill.control.hover", 4.5], ["text.tertiary", "bg.tooltip", 4.5],
      ["text.primary",   "fill.subtle.selected", 4.5], ["text.secondary", "fill.subtle.selected", 4.5],
      ["accent.text",    "bg.base", 4.5], ["accent.text", "bg.layer", 4.5], ["accent.text", "bg.card", 4.5],
      ["link.visited",   "bg.base", 4.5],
      ["text.onAccent",  "accent", 4.5], ["text.onAccent", "accent.hover", 4.5], ["text.onAccent", "accent.pressed", 4.5],
      ["selection.inactive", "accent", 4.5], ["selection.inactive", "accent.pressed", 4.5],
      ["selection.visited",  "accent", 4.5], ["selection.visited",  "accent.pressed", 4.5],
      ["selection.negative", "accent", 4.5], ["selection.negative", "accent.pressed", 4.5],
      ["selection.neutral",  "accent", 4.5], ["selection.neutral",  "accent.pressed", 4.5],
      ["selection.positive", "accent", 4.5], ["selection.positive", "accent.pressed", 4.5],
      ["stroke.strong",  "bg.base", 3.0], ["stroke.strong", "bg.layer", 3.0], ["stroke.strong", "fill.control.pressed", 3.0],
      ["accent",         "bg.base", 3.0], ["accent", "bg.layer", 3.0],
      ["focus.outer",    "bg.base", 3.0],
      ["status.critical","bg.base", 4.5], ["status.caution", "bg.base", 4.5], ["status.success", "bg.base", 4.5], ["status.info", "bg.base", 4.5],
      ["status.critical","bg.secondary", 4.5], ["status.caution", "bg.secondary", 4.5], ["status.success", "bg.secondary", 4.5], ["status.info", "bg.secondary", 4.5],
      ["text.primary",   "caption.close", 3.0]
    ]
  },

  "kde": {
    "about": "Colour scheme groups (section 3.2): each key names a colour token, a group can start from another one, \"mode\": \"night\" uses night values in both schemes.",
    "groups": {
      "Window": {
        "BackgroundNormal": "bg.base", "BackgroundAlternate": "bg.secondary",
        "ForegroundNormal": "text.primary", "ForegroundInactive": "text.secondary",
        "ForegroundActive": "accent.text", "ForegroundLink": "accent.text", "ForegroundVisited": "link.visited",
        "ForegroundNegative": "status.critical", "ForegroundNeutral": "status.caution", "ForegroundPositive": "status.success",
        "DecorationFocus": "accent", "DecorationHover": "accent.hover"
      },
      "View":      { "from": "Window", "BackgroundNormal": "bg.layer", "BackgroundAlternate": "bg.card" },
      "Button":    { "from": "Window", "BackgroundNormal": "fill.control", "BackgroundAlternate": "fill.control.hover" },
      "Selection": { "from": "Window",
        "BackgroundNormal": "accent", "BackgroundAlternate": "accent.pressed",
        "ForegroundNormal": "text.onAccent", "ForegroundInactive": "selection.inactive",
        "ForegroundActive": "#FFFFFF", "ForegroundLink": "#FFFFFF", "ForegroundVisited": "selection.visited",
        "ForegroundNegative": "selection.negative", "ForegroundNeutral": "selection.neutral", "ForegroundPositive": "selection.positive" },
      "Tooltip":   { "from": "Window", "BackgroundNormal": "bg.tooltip", "BackgroundAlternate": "bg.tertiary" },
      "Complementary": { "from": "Window", "mode": "night" },
      "Header":    { "from": "Window" },
      "Header][Inactive": { "from": "Header", "ForegroundNormal": "text.tertiary", "ForegroundInactive": "text.tertiary" }
    },
    "wm": {
      "activeBackground": "bg.base", "activeBlend": "bg.base", "activeForeground": "text.primary",
      "inactiveBackground": "bg.base", "inactiveBlend": "bg.base", "inactiveForeground": "text.tertiary"
    },
    "effects": {
      "ColorEffects:Disabled": { "Color": "bg.base", "ColorAmount": 0, "ColorEffect": 0, "ContrastAmount": 0.55,
                                 "ContrastEffect": 1, "IntensityAmount": 0, "IntensityEffect": 0 },
      "ColorEffects:Inactive": { "ChangeSelectionColor": false, "Color": "bg.base", "ColorAmount": 0, "ColorEffect": 0,
                                 "ContrastAmount": 0, "ContrastEffect": 0, "Enable": false,
                                 "IntensityAmount": 0, "IntensityEffect": 0 }
    },
    "general": { "shadeSortColumn": true, "TitlebarIsAccentColored": false, "accentActiveTitlebar": false },
    "contrast": 4,
    "kdeglobals": {
      "about": "Lines for config/kdeglobals (owned by the look-and-feel package), kept here so they match the schemes.",
      "General": { "accentActiveTitlebar": false },
      "KDE": { "AnimationDurationFactor": 1 }
    }
  },

