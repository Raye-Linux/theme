                              "night": { "color": "#FFFFFF", "alpha": 0.09 },
                              "day": { "color": "#17151C", "alpha": 0.1 } },
    "stroke.divider":       { "use": "separators",
                              "night": { "color": "#FFFFFF", "alpha": 0.08 },
                              "day": { "color": "#17151C", "alpha": 0.08 } },

