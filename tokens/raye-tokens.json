    "link.visited":         { "night": "#D3A6FF", "day": "#8A35C8" },

    "glow":                 { "use": "focus and primary glow, Start hover",
                              "night": { "color": "#7B3CFF", "alpha": 0.22 },
                              "day": { "color": "#7B3CFF", "alpha": 0.14 } },
    "edge.lit":             { "use": "1 px top inner highlight of an accent button",
