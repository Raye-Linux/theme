{
  "about": "Raye design tokens: the one source for every colour, size, type style and timing of the Raye look. tokens/generate.py writes the colour schemes, the Konsole schemes and the QML Tokens singleton from this file. Colours are sRGB hex. A colour is either \"#RRGGBB\" (opaque) or {\"color\", \"alpha\", \"solid\"}: drawn as color at alpha over the base, stored as solid where KDE needs an opaque value (computed over bg.base when not given).",

  "modes": {
    "night": { "scheme": "RayeNight", "name": "Raye Night", "name_fr": "Raye Nuit" },
    "day":   { "scheme": "RayeDay",   "name": "Raye Day",   "name_fr": "Raye Jour" }
  },

  "color": {
    "bg.base":              { "use": "window background, Mica fallback", "night": "#141318", "day": "#F5F4F7" },
    "bg.secondary":         { "use": "nav pane, side areas", "night": "#100F13", "day": "#EEEDF1" },
    "bg.tertiary":          { "use": "headers, sunken bars", "night": "#1A191F", "day": "#FAFAFB" },
    "bg.quarternary":       { "use": "highest solid layer", "night": "#211F26", "day": "#FFFFFF" },
    "bg.layer":             { "use": "content area beside a nav pane, View role",
                              "night": { "color": "#FFFFFF", "alpha": 0.03, "solid": "#1B1A1F" },
                              "day": { "color": "#FFFFFF", "alpha": 0.6, "solid": "#FBFBFC" } },
    "bg.card":              { "use": "settings cards, list groups",
                              "night": { "color": "#FFFFFF", "alpha": 0.05, "solid": "#212026" },
                              "day": { "color": "#FFFFFF", "alpha": 0.85, "solid": "#FFFFFF" } },
    "bg.card.hover":        { "night": { "color": "#FFFFFF", "alpha": 0.08, "solid": "#28272D" },
                              "day": "#F7F7F9" },
    "bg.tooltip":           { "use": "tooltip background (KDE Tooltip role)", "night": "#2A292F", "day": "#FFFFFF" },
    "bg.smoke":             { "use": "behind dialogs",
                              "night": { "color": "#000000", "alpha": 0.45 },
                              "day": { "color": "#17151C", "alpha": 0.3 } },

    "fill.control":         { "use": "button, combo, field at rest",
                              "night": { "color": "#FFFFFF", "alpha": 0.07, "solid": "#26252B" },
                              "day": { "color": "#FFFFFF", "alpha": 0.85, "solid": "#FDFDFD" } },
    "fill.control.hover":   { "night": { "color": "#FFFFFF", "alpha": 0.1, "solid": "#2C2B31" },
                              "day": "#F7F7F9" },
    "fill.control.pressed": { "night": { "color": "#FFFFFF", "alpha": 0.04, "solid": "#201F25" },
                              "day": "#F2F1F4" },
    "fill.control.disabled":{ "night": "#1C1B20", "day": "#F2F1F4" },
    "fill.input.active":    { "use": "focused text field", "night": "#100F13", "day": "#FFFFFF" },
    "fill.subtle.hover":    { "use": "menu and list hover",
                              "night": { "color": "#FFFFFF", "alpha": 0.06 },
                              "day": { "color": "#17151C", "alpha": 0.04 } },
    "fill.subtle.pressed":  { "night": { "color": "#FFFFFF", "alpha": 0.04 },
                              "day": { "color": "#17151C", "alpha": 0.025 } },
    "fill.subtle.selected": { "use": "selected list row, with the pill",
                              "night": { "color": "#FFFFFF", "alpha": 0.09 },
                              "day": { "color": "#17151C", "alpha": 0.06 } },

    "stroke.control":       { "use": "1 px control border",
                              "night": { "color": "#FFFFFF", "alpha": 0.07, "solid": "#2A292F" },
                              "day": { "color": "#17151C", "alpha": 0.08, "solid": "#E1E0E4" } },
    "stroke.control.bottom":{ "use": "bottom edge of a control",
                              "night": { "color": "#FFFFFF", "alpha": 0.04 },
                              "day": { "color": "#17151C", "alpha": 0.16, "solid": "#CFCDD4" } },
    "stroke.strong":        { "use": "checkbox, radio, toggle border at rest (3:1)", "night": "#8B8893", "day": "#85828D" },
    "stroke.card":          { "night": { "color": "#000000", "alpha": 0.2 },
