    "text.secondary":       { "night": "#B5B3BC", "day": "#54525B" },
    "text.tertiary":        { "use": "placeholders, inactive title; a shade past the first draft so placeholders keep 4.5:1, also on a hovered control", "night": "#97949F", "day": "#6C6975" },
