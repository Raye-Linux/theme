#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
    # the copy in /boot is ours, nothing else writes there
    if [ -d /boot/grub/themes/raye ]; then
        rm -r /boot/grub/themes/raye
    fi
    if [ -x /usr/sbin/update-grub ] && [ -e /boot/grub/grub.cfg ]; then
        update-grub || true
    fi
fi
#DEBHELPER#
