#!/bin/sh
set -e
if [ "$1" = configure ]; then
    # copied, not linked: GRUB reads it from /boot
    # a fresh copy, so a file a newer version dropped does not stay
    rm -rf /boot/grub/themes/raye
    mkdir -p /boot/grub/themes/raye
    cp -r /usr/share/grub/themes/raye/. /boot/grub/themes/raye/
    if [ -x /usr/sbin/update-grub ] && [ -e /boot/grub/grub.cfg ]; then
        update-grub || true
    fi
fi
#DEBHELPER#
