Package: raye-theme
Architecture: all
# raye-desktop-layout is a virtual package that ONLY Raye's build of
# plasma-desktop declares (raye/desktop, patches/plasma-desktop/0003). It is
# named here, and not plasma-desktop-data, because Ubuntu's own build of that
# package satisfies the real name and ships no layout at all: the dependency
# has to be one that the stock archive cannot answer.
#
# Without it, `apt install raye-theme` on an upstream plasma-desktop gave a
# first login with NO TASKBAR -- worse than the upstream bar the Raye layout
# replaces. This look-and-feel deliberately ships no layouts/ of its own (see
# tests/lookandfeel/test_no_layout.py), so the layout it needs must come from
# the desktop's shell package, and apt has to refuse rather than hand over a
# desktop that cannot draw its own bar.
Depends: breeze,
         fonts-cascadia-code,
         fonts-inter,
         libglib2.0-bin,
         plasma-workspace,
         plymouth-theme-raye,
         python3,
         qml6-module-org-kde-plasma-plasma5support,
         qml6-module-qtcore,
         qml6-module-qtmultimedia,
         raye-desktop-layout,
         raye-shell,
         ${misc:Depends}
Description: Raye Linux desktop look
 The Raye look for Plasma: dark colours with a violet accent, the Inter
 font, six wallpapers and two animated ones, the eye logo on the Start
 button, a centred taskbar, the login splash and the login screen
 background.
 .
 It carries the Raye Night and Raye Day colour schemes, which every
 other piece of the desktop follows.

Package: raye-style
Architecture: any
Depends: qml6-module-org-kde-kirigami,
         ${misc:Depends},
         ${shlibs:Depends}
Description: Raye Linux widget style and window decoration
 The way buttons, fields, menus, scroll bars and title bars are drawn in
 Raye: rounded corners, thin strokes, soft shadows and short animations,
 on the Raye colours.
 .
 It also holds the Raye building blocks that Raye's own windows are made
 of, so every Raye application looks the same.

Package: raye-icon-theme
Architecture: all
Depends: breeze-icon-theme,
         hicolor-icon-theme,
         papirus-icon-theme,
         ${misc:Depends}
Description: Raye Linux icons
 The Raye icon set: folders and places, file types, drives, applications,
 the Settings categories and the small monoline icons in the taskbar
 tray. A light and a dark variant.

Package: raye-cursor-theme
Architecture: all
Depends: ${misc:Depends}
Description: Raye Linux mouse pointers
 The Raye pointers: a white arrow with a dark outline, a violet busy
 ring, and the resize, text and hand shapes that go with them, at every
 size a high resolution screen needs.

Package: raye-sound-theme
Architecture: all
Depends: sound-theme-freedesktop,
         ${misc:Depends}
Description: Raye Linux sounds
 The short sounds Raye plays: signing in, a notification, plugging a
 drive in or out, a low battery, an error, the volume changing and
 emptying the bin. Nothing plays while the computer starts.

Package: raye-shell
Architecture: any
# libcanberra-pulse: the volume sound goes to a sink by its index, which
# the ALSA backend alone cannot do
Depends: plasma-workspace (>= 4:6.6),
         plasma-nm,
         plasma-pa,
         libcanberra-pulse,
         bluedevil,
         powerdevil,
         kwin-wayland,
         raye-style,
         qml6-module-qtcore,
         ${misc:Depends},
         ${shlibs:Depends}
Breaks: plasma-workspace (>= 4:6.7~),
        plasma-desktop (>= 4:6.7~),
        kwin-wayland (>= 4:6.7~)
Description: Raye Linux desktop shell
 The taskbar, the Start menu, quick settings, the clock and its
 notifications, the window switcher and the on-screen displays for
 volume and brightness.

Package: raye-hyprland
Architecture: any
# The taskbar, Start, quick settings and toasts are raye-shell's own QML
# views, loaded from its applets: the two always come from one build.
Depends: raye-shell (= ${binary:Version}),
         raye-theme,
         hyprland (>= 0.53),
         hyprlock,
         hypridle,
         xdg-desktop-portal-hyprland,
         qml6-module-org-kde-layershell,
         grim,
         slurp,
         wl-clipboard,
         libnotify-bin,
         wireplumber,
         ${misc:Depends},
         ${shlibs:Depends}
Recommends: brightnessctl,
            playerctl,
            xdg-user-dirs
Description: Raye Linux desktop on Hyprland
 The Raye desktop on the Hyprland compositor, offered next to the Plasma
 one at sign-in: the same centred taskbar, Start menu, quick settings and
 notifications, the Windows keys, the lock screen and the Raye motion.
 Windows float and open centred, as on the Plasma desktop.

Package: plymouth-theme-raye
Architecture: all
Depends: fonts-inter,
         plymouth,
         plymouth-label,
         ${misc:Depends}
Description: Raye Linux boot screen
 The Raye eye on the night background while the computer starts, with a
 password prompt for encrypted disks.

Package: grub-theme-raye
Architecture: all
Depends: grub-common,
         ${misc:Depends}
Description: Raye Linux boot menu
 The Raye look for the boot menu, which only shows up when another
 system such as Windows is installed next to Raye.

Package: sddm-theme-raye
