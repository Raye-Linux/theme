#!/bin/sh
# A file this version no longer replaces goes back to Plasma. dpkg has
# removed our link by now, so the stock file can take its name again.
set -e

QML=/usr/lib/#DEB_HOST_MULTIARCH#/qt6/qml/org/kde/plasma/workspace/osd
OSD="#RAYE_OSD#"
LOCK=/usr/share/plasma/shells/org.kde.plasma.desktop/contents/lockscreen
LOCKFILES="#RAYE_LOCK#"

# also after a failed upgrade or removal: the old version is configured
# again, and a diversion the failed new version added must not stay
# without its link
case "$1" in
    configure|abort-upgrade|abort-remove|abort-deconfigure)
        dpkg-divert --list --package raye-shell | while read -r _ _ file _; do
            case "$file" in
                "$QML"/*) name=${file#"$QML"/}; keep=$OSD ;;
                "$LOCK"/*) name=${file#"$LOCK"/}; keep=$LOCKFILES ;;
                *) continue ;;
            esac
            case " $keep " in
                *" $name "*) continue ;;
            esac
            if [ ! -L "$DPKG_ROOT$file" ]; then
                dpkg-divert --package raye-shell --remove --rename \
                    --divert "$file.plasma" "$file"
            fi
        done
        ;;
esac

#DEBHELPER#

exit 0
