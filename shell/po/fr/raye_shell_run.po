msgid "Run"
msgstr "Exécuter"

msgid "Type the name of a program, folder, document or Internet resource, and Raye will open it for you."
msgstr "Entrez le nom d’un programme, dossier, document ou ressource Internet, et Raye l’ouvrira pour vous."

msgid "Open:"
msgstr "Ouvrir :"

msgid "OK"
msgstr "OK"

msgid "Cancel"
msgstr "Annuler"

msgid "Browse…"
msgstr "Parcourir…"

msgid "Browse"
msgstr "Parcourir"

msgid "All files (*)"
msgstr "Tous les fichiers (*)"

msgid "Close"
msgstr "Fermer"

msgid "Show recent"
msgstr "Afficher les éléments récents"

msgid "Raye can't find \"%1\". Make sure you typed the name correctly, and then try again."
msgstr "Raye ne trouve pas « %1 ». Vérifiez que le nom est correct, puis réessayez."

msgid "Raye couldn't open \"%1\". %2"
msgstr "Raye n’a pas pu ouvrir « %1 ». %2"
