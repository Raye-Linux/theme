# French strings of Raye Snap (snap layouts, Windows arrow keys).
msgid ""
msgstr ""
"Project-Id-Version: raye-shell\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
