msgid "Safely Remove Hardware and Eject Media"
msgstr "Retirer le périphérique en toute sécurité et éjecter le média"

msgid "No devices to eject"
msgstr "Aucun appareil à éjecter"

msgctxt "@info a kind of device"
msgid "USB drive"
msgstr "Clé USB"

msgctxt "@info a kind of device"
msgid "Memory card"
msgstr "Carte mémoire"

msgctxt "@info a kind of device"
msgid "Disc"
msgstr "Disque"

msgctxt "@info a kind of device"
msgid "Removable drive"
msgstr "Lecteur amovible"

msgctxt "@info size and kind of a device: 7.5 GB USB drive"
msgid "%1 %2"
msgstr "%2 de %1"

msgctxt "@action:inmenu"
msgid "Eject %1"
msgstr "Éjecter %1"

msgctxt "@action:inmenu"
msgid "Open %1 in Files"
msgstr "Ouvrir %1 dans Fichiers"

msgctxt "@action:inmenu"
msgid "Open in Files"
msgstr "Ouvrir dans Fichiers"

msgctxt "@title notification"
msgid "Safe to remove hardware"
msgstr "Le matériel peut être retiré en toute sécurité"

msgctxt "@info notification"
msgid "The '%1' device can now be safely removed from the computer."
msgstr "Le périphérique « %1 » peut être retiré de l’ordinateur en toute sécurité."

msgctxt "@title notification"
msgid "Problem ejecting USB device"
msgstr "Problème lors de l’éjection du périphérique USB"

msgctxt "@title notification"
msgid "Problem ejecting memory card"
msgstr "Problème lors de l’éjection de la carte mémoire"

msgctxt "@title notification"
msgid "Problem ejecting disc"
msgstr "Problème lors de l’éjection du disque"

