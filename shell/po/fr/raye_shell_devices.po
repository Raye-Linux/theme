msgctxt "@info notification: the apps keeping a device busy"
msgid "In use by: %1"
msgstr "Utilisé par : %1"

msgctxt "@title notification: a USB drive was plugged in"
msgid "%1 (%2)"
msgstr "%1 (%2)"

msgctxt "@info notification"
msgid "Select to choose what happens with removable drives."
msgstr "Sélectionnez pour choisir ce qui se passe avec les lecteurs amovibles."

msgctxt "@action:button notification"
msgid "Open folder to view files"
msgstr "Ouvrir le dossier et afficher les fichiers"

msgctxt "@action:button notification"
msgid "Take no action"
msgstr "Ne rien faire"

msgctxt "@title notification source"
msgid "Devices"
msgstr "Périphériques"
