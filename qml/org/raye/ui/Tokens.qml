    // Night or Day and the accent, from a window background, its text
    // and the highlight. The colour scheme answers only once the platform
    // plugin behind Kirigami is loaded; before that every role is black.
    // Text that cannot be told from its background is not a scheme, so
    // that paints Raye Night rather than a black application. Neither is
    // Qt's own palette or Plasma's built-in one, which is what a program
    // gets with no platform theme or a kdeglobals that only names the
    // scheme: Raye never ships them, so they paint Raye Night too.
    function readScheme(background, text, highlight) {
        if (contrast(background, text) <= 1.5 || isFallbackPalette(background, highlight))
            return { night: true, accent: Qt.color("#7b3cff") }
        return { night: luminance(background) < 0.5, accent: Qt.color(highlight) }
    }

    function isFallbackPalette(background, highlight) {
        const windows = ["#efefef", "#eff0f1"]
        const highlights = ["#308cc6", "#3daee9"]
        return windows.some(c => Qt.colorEqual(background, c))
            && highlights.some(c => Qt.colorEqual(highlight, c))
    }

    // WCAG 2 relative luminance of a colour (a color or a "#rrggbb" string)
    function luminance(c) {
        c = Qt.color(c)
        function lin(v) { return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4) }
        return 0.2126 * lin(c.r) + 0.7152 * lin(c.g) + 0.0722 * lin(c.b)
    }

    function contrast(a, b) {
        const la = luminance(a), lb = luminance(b)
        return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05)
    }

    // a moved toward b by t (0..1), kept on 8 bits like the stored colours
    function mix(a, b, t) {
        a = Qt.color(a); b = Qt.color(b)
        function ch(x, y) { return Math.round((x + (y - x) * t) * 255) / 255 }
        return Qt.rgba(ch(a.r, b.r), ch(a.g, b.g), ch(a.b, b.b), 1)
    }

    // the grey of the same brightness
    function grey(c) {
        c = Qt.color(c)
        const y = Math.round((0.299 * c.r + 0.587 * c.g + 0.114 * c.b) * 255) / 255
        return Qt.rgba(y, y, y, 1)
    }

    // (hue, saturation, lightness), each 0..1 -- the HSL of CSS and of
    // Python's colorsys, written out so the three rules agree exactly
    function hsl(c) {
        c = Qt.color(c)
        const hi = Math.max(c.r, c.g, c.b), lo = Math.min(c.r, c.g, c.b)
        const l = (hi + lo) / 2
        if (hi === lo)
            return { h: 0, s: 0, l: l }
        const range = hi - lo
        const s = l <= 0.5 ? range / (hi + lo) : range / (2 - hi - lo)
        const rc = (hi - c.r) / range, gc = (hi - c.g) / range, bc = (hi - c.b) / range
        let h = c.r === hi ? bc - gc : c.g === hi ? 2 + rc - bc : 4 + gc - rc
        h = ((h / 6) % 1 + 1) % 1
        return { h: h, s: s, l: l }
    }

    // back from (hue, saturation, lightness), on 8 bits like mix()
    function fromHsl(h, s, l) {
        function q(v) { return Math.round(v * 255) / 255 }
        if (s === 0)
            return Qt.rgba(q(l), q(l), q(l), 1)
        const m2 = l <= 0.5 ? l * (1 + s) : l + s - l * s
        const m1 = 2 * l - m2
        function ch(hue) {
            hue = ((hue % 1) + 1) % 1
            if (hue < 1 / 6) return m1 + (m2 - m1) * hue * 6
            if (hue < 0.5) return m2
            if (hue < 2 / 3) return m1 + (m2 - m1) * (2 / 3 - hue) * 6
            return m1
        }
        return Qt.rgba(q(ch(h + 1 / 3)), q(ch(h)), q(ch(h - 1 / 3)), 1)
    }

    // white for black and black for white, null for anything else
    function opposite(c) {
        if (Qt.colorEqual(c, "#ffffff"))
            return Qt.color("#000000")
        if (Qt.colorEqual(c, "#000000"))
            return Qt.color("#ffffff")
        return null
    }

    // The shades of any accent colour: what the Qt style does too.
    // Returns { accent, hover, pressed, text, disabled, onAccent }.
    // Text on the fill holds its ratio on the accent, hover and pressed
    // together: a shade that loses it moves back toward the accent, a
    // pressed shade left with less than half its change goes the other
    // way, and a hover left so goes the pressed way at half its change.
    function deriveAccent(accent, isNight) {
        accent = Qt.color(accent)
        const base = Qt.color(isNight ? "#141318" : "#f5f4f7")
        const light = Qt.color("#ffffff"), dark = Qt.color("#17151c")
        const want = 4.5
        const onAccent = contrast(light, accent) >= want ? light
                       : contrast(dark, accent) >= want ? dark
                       : contrast(light, accent) >= contrast(dark, accent) ? light : dark
        const floor = Math.min(want, contrast(onAccent, accent))
        function backOff(toward, amount) {
            while (amount > 0 && contrast(onAccent, mix(accent, toward, amount)) < floor)
                amount = Math.max(0, Math.round((amount - 0.005) * 1e6) / 1e6)
            return amount
        }
        const hoverBy = isNight ? 0.12 : 0.12
        const pressBy = isNight ? 0.12 : 0.24
        let pressedTo = Qt.color(isNight ? "#000000" : "#000000")
        let pressedBy = backOff(pressedTo, pressBy)
        const other = opposite(pressedTo)
        if (pressedBy < pressBy / 2 && other !== null) {
            const flipped = backOff(other, pressBy)
            if (flipped >= pressBy / 2) {
                pressedTo = other
                pressedBy = flipped
            }
        }
        let hoveredTo = Qt.color(isNight ? "#ffffff" : "#000000")
        let hoveredBy = backOff(hoveredTo, hoverBy)
        if (hoveredBy < hoverBy / 2 && !Qt.colorEqual(pressedTo, hoveredTo) && pressedBy > 0) {
            hoveredTo = pressedTo
            hoveredBy = pressedBy / 2
        } else if (Qt.colorEqual(pressedTo, hoveredTo)) {
            hoveredBy = Math.min(hoveredBy, pressedBy / 2)
        }
        const toward = isNight ? "#ffffff" : "#000000"
        const wantText = isNight ? 7 : 6
        let text = accent
        let t = 0
        while (contrast(text, base) < wantText && t < 1) {
            t = Math.min(1, t + 0.02)
            text = mix(accent, toward, t)
        }
        const disabled = mix(base, accent, 0.35)
        return {
            accent: accent,
            hover: mix(accent, hoveredTo, hoveredBy),
            pressed: mix(accent, pressedTo, pressedBy),
            text: text,
            disabled: mix(disabled, grey(disabled), 0.3),
            onAccent: onAccent
        }
    }

    // `seed` with its LIGHTNESS walked until it holds every minimum on
    // its background, hue and saturation kept. It stops at the first
    // lightness that holds, so the tint keeps as much of its own colour
    // as the ratio allows, and ends at white (or black) when none holds.
    function toContrast(seed, backgrounds, minimums, towardLight) {
        const c = hsl(seed)
        const end = towardLight ? 1 : 0
        function holds(colour) {
            for (let i = 0; i < backgrounds.length; ++i)
                if (contrast(colour, backgrounds[i]) < minimums[i] - 1e-9)
                    return false
            return true
        }
        if (holds(seed))
            return seed
        const steps = Math.floor(Math.abs(end - c.l) / 0.005) + 1
        for (let i = 1; i <= steps; ++i) {
            const colour = fromHsl(c.h, c.s, c.l + (end - c.l) * (i / steps))
            if (holds(colour))
                return colour
        }
        return fromHsl(c.h, c.s, end)
    }

    // The tinted foregrounds of a selected row for any accent: what
    // accent.py writes into the user's colour scheme too.
    // These were constants -- three of them with no rule at all --
    // tuned by eye for the violet. A constant on a moving background
    // holds no ratio: on an amber accent the negative tint sat at
    // 1.92:1. Each one is now held to the minimum on BOTH selection
    // backgrounds, the accent and its pressed shade (the alternate
    // selected row). `accent`-hued tints start where the table puts them
    // between the text on the accent and the accent; the three signals
    // keep their own hue, because a negative that reads as the accent
    // says nothing.
    function deriveSelection(accent, isNight, acc) {
        accent = Qt.color(accent)
        const light = Qt.color("#ffffff"), dark = Qt.color("#17151c")
        const want = 4.5
        const backgrounds = [Qt.color(acc.accent), Qt.color(acc.pressed)]
        // nothing beats white or the dark text, so that is the floor on a
        // background no colour holds `want` on
        const minimums = backgrounds.map(function (bg) {
            return Math.min(want, Math.max(contrast(light, bg), contrast(dark, bg)))
        })
        const towardLight = Qt.colorEqual(acc.onAccent, light)
        const amounts = isNight ? ({ inactive: 0.110664, visited: 0.103089 }) : ({ inactive: 0.110664, visited: 0.103089 })
        const seeds = isNight ? ({ negative: "#ffe8ec", neutral: "#ffebc0", positive: "#cff6e0" }) : ({ negative: "#ffe8ec", neutral: "#ffebc0", positive: "#cff6e0" })
        const out = {}
        for (const key in amounts)
            out[key] = toContrast(mix(acc.onAccent, accent, amounts[key]),
                                  backgrounds, minimums, towardLight)
        for (const key in seeds)
            out[key] = toContrast(Qt.color(seeds[key]), backgrounds, minimums, towardLight)
        return out
    }
