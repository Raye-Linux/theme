#!/bin/sh
# Win+Shift+S on Hyprland: a part of the screen (region) or all of it
# (screen) to the clipboard and to Pictures/Screenshots, with a
# notification that opens it.
set -eu

mode=${1:-region}
pictures=$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")
dir=$pictures/Screenshots
mkdir -p "$dir"
file=$dir/$(date +%Y-%m-%d\ %H-%M-%S).png

case "$mode" in
region)
    # Escape in slurp: nothing is taken
    area=$(slurp -d -b 0e0a1780 -c 7b3cffff -s 7b3cff22 -w 2) || exit 0
    grim -g "$area" "$file"
    ;;
screen)
    grim "$file"
    ;;
*)
    echo "usage: raye-hypr-screenshot [region|screen]" >&2
    exit 2
    ;;
esac

wl-copy --type image/png < "$file"

case "${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}" in
fr*) title='Capture copiée'; body="Elle est aussi dans ${pictures##*/} > Screenshots."; open='Ouvrir' ;;
*) title='Screenshot copied'; body="It is also in ${pictures##*/} > Screenshots."; open='Open' ;;
esac
if command -v notify-send >/dev/null 2>&1; then
    action=$(notify-send -a "Raye" -i "$file" -A "open=$open" "$title" "$body" || true)
    [ "$action" = open ] && xdg-open "$file" >/dev/null 2>&1 &
fi
exit 0
