#!/bin/sh
# The Raye desktop on Hyprland, started by the sign-in screen.
#
# Hyprland reads ~/.config/raye-hyprland/hyprland.conf, made here the
# first time: it sources Raye's defaults, the keyboard of the machine,
# then the user's own file, so the user's lines win and a Raye update
# reaches every account.
set -eu

conf=${XDG_CONFIG_HOME:-$HOME/.config}/raye-hyprland
system=${RAYE_HYPRLAND_DATA:-/usr/share/raye/hyprland}
mkdir -p "$conf"

# Raye's own file is written again at each start (an update may add a
# line to it); a file the user wrote instead is kept.
if [ ! -e "$conf/hyprland.conf" ] || head -n 1 "$conf/hyprland.conf" | grep -q '^# Made once by Raye'; then
    cat > "$conf/hyprland.conf.new" <<CONF
# Made once by Raye. Put your own settings in user.conf: this file and
# Raye's own settings may be replaced by an update.
source = $system/hyprland.conf
source = $conf/keyboard.conf
source = $conf/monitors.conf
source = $conf/user.conf
CONF
    mv "$conf/hyprland.conf.new" "$conf/hyprland.conf"
fi
[ -e "$conf/user.conf" ] || printf '# Your Hyprland settings. They win over Raye'"'"'s.\n' > "$conf/user.conf"

# the keyboard the machine was set up with (the installer writes it there)
"${RAYE_HYPRLAND_KEYBOARD:-/usr/libexec/raye-hyprland-start}" --keyboard \
    "${RAYE_KEYBOARD_FILE:-/etc/default/keyboard}" > "$conf/keyboard.conf.new"
mv "$conf/keyboard.conf.new" "$conf/keyboard.conf"

# the size of each screen picked in Raye Settings (KWin keeps it), so
# Hyprland shows things at the same size as Plasma does
"${RAYE_HYPRLAND_KEYBOARD:-/usr/libexec/raye-hyprland-start}" --monitors \
    "${XDG_CONFIG_HOME:-$HOME/.config}/kwinoutputconfig.json" > "$conf/monitors.conf.new" \
    || printf '# The screen settings of Plasma could not be read.\n' > "$conf/monitors.conf.new"
mv "$conf/monitors.conf.new" "$conf/monitors.conf"

# The region and language picked in Raye Settings (plasma-localerc), as the
# Plasma session exports them: the clock is 12 or 24 hours, and dates are
# written, the way the user's region writes them. Only the known keys, and
# only a plain locale name: the file is the user's, not a script.
localerc=${XDG_CONFIG_HOME:-$HOME/.config}/plasma-localerc
if [ -r "$localerc" ]; then
    picked=$(awk '
        /^\[/ { group = $0; next }
        group == "[Formats]" && /^(LANG|LC_NUMERIC|LC_TIME|LC_MONETARY|LC_MEASUREMENT|LC_COLLATE|LC_CTYPE|LC_PAPER|LC_ADDRESS|LC_NAME|LC_TELEPHONE)=[A-Za-z0-9_.@-]+$/ { print }
        group == "[Translations]" && /^LANGUAGE=[A-Za-z0-9_.@:-]+$/ { print }
    ' "$localerc")
    for pair in $picked; do
        export "$pair"
    done
fi

# the lock screen speaks the session's language
lock_text='PIN or password'
lock_fail='That password is not right'
case "${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}" in
fr*)
    lock_text='Code PIN ou mot de passe'
    lock_fail="Ce mot de passe n'est pas le bon"
    ;;
esac
sed -e "s|PIN or password|$lock_text|" -e "s|That password is not right|$lock_fail|" \
    "$system/hyprlock.conf" > "$conf/hyprlock.conf"

export XDG_CURRENT_DESKTOP=Hyprland
# the Raye categories: without a menu the app database (Start, the
# taskbar's icons, "Open with") is empty. Same as the Plasma session.
export XDG_MENU_PREFIX=raye-
export XDG_SESSION_DESKTOP=raye-hyprland
export XDG_SESSION_TYPE=wayland

[ -n "${RAYE_HYPRLAND_DRY_RUN:-}" ] && exit 0

# Coming straight from Plasma (Settings > Desktop environment, or a quick
# sign-out and sign-in), the account's service manager is still the same:
# Plasma's own services may still be there, and plasmashell restarts by
# itself when its compositor goes. Started again with this session's
# display, it put Plasma's taskbar and desktop on Hyprland, next to Raye's.
# They have no place here, unless the account really has a Plasma session
# open elsewhere at the same time (another screen of the PC).
plasma_open_elsewhere() {
    command -v loginctl >/dev/null 2>&1 || return 1
    for s in $(loginctl show-user "$(id -u)" -p Sessions --value 2>/dev/null); do
        [ "$s" = "${XDG_SESSION_ID:-}" ] && continue
        info=$(loginctl show-session "$s" -p State -p Type -p Desktop 2>/dev/null) || continue
        case $info in *State=closing*) continue ;; esac
        case $info in *Type=wayland*|*Type=x11*) ;; *) continue ;; esac
        case $info in *Desktop=KDE*|*Desktop=plasma*) return 0 ;; esac
    done
    return 1
}
if command -v systemctl >/dev/null 2>&1 && ! plasma_open_elsewhere; then
    systemctl --user stop plasma-workspace.target plasma-workspace-wayland.target \
        plasma-workspace-x11.target plasma-core.target 2>/dev/null || true
    systemctl --user stop 'plasma-*.service' 2>/dev/null || true
    systemctl --user reset-failed 'plasma-*.service' 2>/dev/null || true
fi

# The screen of this session's terminal shows for a moment once Hyprland
# is gone (until the sign-in screen or the next desktop draws): leave it
# empty, without a cursor, rather than with old text.
blank_vt() {
    [ -t 0 ] || return 0
    printf '\033[0m\033[H\033[2J\033[3J\033[?25l' >&0 2>/dev/null || true
}

# not exec: once Hyprland ends, the session's apps started through
# raye-hyprland-session.target (XDG autostart) end with it
rc=0
start-hyprland -- --config "$conf/hyprland.conf" || rc=$?
blank_vt
systemctl --user stop raye-hyprland-session.target 2>/dev/null || true
exit "$rc"
